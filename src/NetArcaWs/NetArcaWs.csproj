<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>NetArcaWs</PackageId>
    <Version>0.5.0</Version>
    <Authors>NetArcaWs .NET contributors</Authors>
    <RepositoryUrl>https://github.com/ARSASWebDesign/NetArcaWs</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/ARSASWebDesign/NetArcaWs</PackageProjectUrl>
    <Description>Native .NET 10 multitenant ARCA clients, WSAA, complete typed SOAP contracts, durable invoicing and opt-in health checks.</Description>
    <Copyright>Original PyAfipWs: Copyright (C) 2008-2021 Mariano Reingart. .NET port: NetArcaWs .NET contributors.</Copyright>
    <PackageLicenseExpression>LGPL-3.0-or-later</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>afip;argentina;wsfe;web-services</PackageTags>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.12" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../docs/wiki/**/*.md" Pack="true" PackagePath="docs/wiki/%(RecursiveDir)" />
    <None Include="../../docs/reference/contracts/**/*" Pack="true" PackagePath="docs/reference/contracts/%(RecursiveDir)" />
    <None Include="../../docs/adr/0004-public-soap-contracts.md" Pack="true" PackagePath="docs/adr/" />
    <None Include="../../CONTRIBUTING.md" Pack="true" PackagePath="/" />
    <None Include="../../docs/releases.md" Pack="true" PackagePath="docs/" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../../COPYING" Pack="true" PackagePath="/" />
    <None Include="../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" />
    <None Include="../../ARCHITECTURE.md" Pack="true" PackagePath="/" />
    <None Include="../../docs/certificates-cli.md" Pack="true" PackagePath="docs/" />
    <None Include="../../docs/plans/hito-7-wiki.md" Pack="true" PackagePath="docs/plans/" />
    <None Include="../../PROGRESS.md" Pack="true" PackagePath="/" />
    <None Include="../../docs/adr/0003-in-memory-certificates.md" Pack="true" PackagePath="docs/adr/" />
    <None Include="../../docs/plans/hito-1.md" Pack="true" PackagePath="docs/plans/" />
    <None Include="../../docs/reference/wsaa-homologation.wsdl" Pack="true" PackagePath="docs/reference/" />
    <None Include="../../docs/reference/healthchecks-contracts.md" Pack="true" PackagePath="docs/reference/" />
    <None Include="../../docs/adr/0002-arca-tenant-context.md" Pack="true" PackagePath="docs/adr/" />
    <None Include="../../docs/adr/0001-safe-invoice-retries.md" Pack="true" PackagePath="docs/adr/" />
  </ItemGroup>
</Project>
