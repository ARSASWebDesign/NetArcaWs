<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>NetArcaWs.Rendering.Pdf</PackageId>
    <Version>0.6.0</Version>
    <Authors>NetArcaWs .NET contributors</Authors>
    <RepositoryUrl>https://github.com/ARSASWebDesign/NetArcaWs</RepositoryUrl>
    <Description>Optional PDF rendering for NetArcaWs fiscal documents.</Description>
    <PackageLicenseExpression>LGPL-3.0-or-later</PackageLicenseExpression>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../NetArcaWs/NetArcaWs.csproj" />
    <PackageReference Include="PDFsharp-MigraDoc" Version="6.2.4" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="StbImageSharp" Version="2.30.15" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Rendering.Shared/DocumentLayout.cs" Link="Shared/DocumentLayout.cs" />
    <Compile Include="../Rendering.Shared/DocumentFiscalRules.cs" Link="Shared/DocumentFiscalRules.cs" />
    <Compile Include="../Rendering.Shared/FiscalQrPayload.cs" Link="Shared/FiscalQrPayload.cs" />
    <Compile Include="../Rendering.Shared/DocumentRenderValidator.cs" Link="Shared/DocumentRenderValidator.cs" />
    <Compile Include="../Rendering.Shared/FiscalAssociatedDocuments.cs" Link="Shared/FiscalAssociatedDocuments.cs" />
    <EmbeddedResource Include="Resources/NotoSans-Regular.ttf" />
    <EmbeddedResource Include="Resources/NotoSans-Bold.ttf" />
    <None Include="Resources/OFL.txt" Pack="true" PackagePath="licenses/NotoSans-OFL.txt" />
  </ItemGroup>
</Project>
